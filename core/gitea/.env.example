# =========================
# Gitea LAN configuration
# =========================

# =========================
# ВАЖНО: IP вашего сервера в LAN
# =========================
# Укажи IP сервера, по которому ты реально заходишь в браузере из локальной сети.
# Пример: 192.168.1.50
SERVER_IP=192.168.1.50

# Для LAN без доменов:
# DOMAIN оставляем равным IP (это нормально на старте)
GITEA_DOMAIN="${SERVER_IP}"
GITEA_SSH_DOMAIN="${SERVER_IP}"

# ROOT_URL — то, что будет генерироваться в ссылках внутри UI.
# В LAN-варианте это IP + порт.
GITEA_ROOT_URL="http://${SERVER_IP}:${GITEA_HTTP_PORT}/"
