# ============================================================
# CORE INFRASTRUCTURE ENV
# ============================================================

# Timezone
TZ=Asia/Bishkek

# Docker container name
DCN_CORE_DNS=core_dns
DCN_CORE_PROXY=core_proxy
DCN_CORE_GITEA=core_gitea

# Docker network for core services
CORE_NETWORK_NAME=net-core

# -------------------------
# Gitea (core service)
# -------------------------
GITEA_DOMAIN=gitea.egor.lan
GITEA_ROOT_URL=http://gitea.egor.lan/

GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

# =========================
# Rootless UID/GID
# =========================
# Узнай на сервере:
# id -u
# id -g
GITEA_USER_UID=1000
GITEA_USER_GID=1000

LAN_SUBNET=192.168.88.0/24

DNS_HOST_PORT=5353
DNS_HOST_IP=192.168.88.234

LOCAL_DNS_ZONE=egor.lan
